# Copy this file to .env and fill in values for services you enable locally.
# Never commit .env: it can contain credentials.

# Application
APP_NAME=PaperProbe API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Allowed browser origins for a future frontend (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Gemini: required when the extraction service is enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Data stores: not yet connected by this skeleton, but reserved for the pipeline.
# These values are used by docker compose for the local database. Change the
# password before using anything other than a local development environment.
POSTGRES_USER=paperprobe
POSTGRES_PASSWORD=paperprobe
POSTGRES_DATABASE=paperprobe
POSTGRES_PORT=5433
POSTGRES_DSN=postgresql+asyncpg://paperprobe:paperprobe@127.0.0.1:5433/paperprobe
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=paperprobe

# Optional OpenReview credentials for authenticated collection / higher limits.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
