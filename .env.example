# Copy this file to .env and fill in values for services you enable locally.
# Never commit .env: it can contain credentials.

# Application
APP_NAME=PaperProbe API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Allowed browser origins for a future frontend (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Gemini: required when the extraction service is enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Data stores: not yet connected by this skeleton, but reserved for the pipeline.
POSTGRES_DSN=postgresql+asyncpg://paperprobe:paperprobe@localhost:5432/paperprobe
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=paperprobe

# Optional OpenReview credentials for authenticated collection / higher limits.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
